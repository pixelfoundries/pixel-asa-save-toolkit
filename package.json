{
  "name": "pixel-asa-save-toolkit",
  "version": "0.0.1",
  "description": "Pixel Foundries Ark ASA Save Toolkit for reading and writing Ark ASA save files",
  "type": "module",
  "homepage": "https://www.pixelfoundries.com",
  "author": "Doug Kasten <dkasten@pixelfoundries.com>",
  "license": "MIT",
  "bugs": {
    "email": "pixelfoundries@gmail.com"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "keywords": [
    "asa",
    "save",
    "ark"
  ],
  "bin": {
    "asa-save-file": "./dist-node/bin/asa-save-file"
  },
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "node": "./dist-node/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "dist-node",
    "!**/test"
  ],
  "dependencies": {
    "@types/node": "^24.7.2",
    "commander": "^14.0.2",
    "sqlite3": "^5.1.7",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.28.5",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^9.39.1",
    "@types/jest": "^30.0.0",
    "bundlewatch": "^0.4.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^16.2.7",
    "neostandard": "^0.12.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.2",
    "release-please": "^17.1.3",
    "rimraf": "^6.1.2",
    "runmd": "^1.4.1",
    "standard-version": "^9.5.0",
    "typedoc": "^0.28.14",
    "typedoc-material-theme": "^1.4.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0"
  },
  "scripts": {
    "build": "./scripts/build.sh",
    "build:watch": "tsc --watch -p tsconfig.json",
    "bundlewatch": "npm run pretest:browser && bundlewatch --config bundlewatch.config.json",
    "docs:diff": "npm run docs && git diff -I \"[0-9a-f-]{36}\" README.md",
    "docs": "rimraf ./docs/typedoc && typedoc && npm run build && npx runmd --output=README.md README_js.md",
    "eslint:check": "eslint src/ *.[jt]s",
    "eslint:fix": "eslint --fix src/ *.[jt]s",
    "examples:browser:rollup:build": "cd examples/browser-rollup && npm run build",
    "examples:browser:webpack:build": "cd examples/browser-webpack && npm run build",
    "examples:node:esmodules:test": "cd examples/node-esmodules && npm test",
    "examples:node:jest:test": "cd examples/node-jest && npm test",
    "examples:node:typescript:test": "cd examples/typescript && npm test",
    "lint": "npm run eslint:check && npm run prettier:check",
    "md": "runmd --watch --output=README.md README_js.md",
    "prepack": "npm run build -- --no-pack",
    "prepare": "husky",
    "prepublishOnly": "npm run build",
    "prettier:check": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "release": "standard-version --no-verify",
    "test:benchmark": "cd examples/benchmark && npm test",
    "test:browser": "wdio run ./wdio.conf.js",
    "test:node": "npm-run-all --parallel examples:node:**",
    "test:watch": "node --test --enable-source-maps --watch dist-node/test/*.js",
    "test": "node --test --enable-source-maps dist-node/test/*.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pixelfoundries/pixel-asa-save-toolkit"
  },
  "lint-staged": {
    "*": [
      "prettier --no-error-on-unmatched-pattern --write"
    ],
    "*.{js,jsx}": [
      "eslint --no-error-on-unmatched-pattern --fix"
    ]
  },
  "standard-version": {
    "scripts": {
      "postchangelog": "prettier --write CHANGELOG.md"
    }
  },
  "packageManager": "npm@11.6.3"
}
