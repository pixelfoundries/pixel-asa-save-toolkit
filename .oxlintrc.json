{
  "env": {
    "node": true
  },
  "plugins": [
    "vitest",
    "unicorn",
    "typescript",
    "eslint",
    "oxc",
    "import",
    "node"
  ],
  "rules": {
    "unicorn/no-abusive-eslint-disable": "error",
    "curly": ["error", "all"],
    "no-warning-comments": "warn",
    "no-console": "error"
  }
}