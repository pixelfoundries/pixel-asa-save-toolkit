{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["./src"],
  "plugin": ["typedoc-material-theme"],
  "themeColor": "#2f66c6",
  "out": "./docs/typedoc",
  "name": "Pixel ASA Save File Toolkit",
  "categorizeByGroup": true,
  "navigation": {
    "includeGroups": true,
    "includeCategories": true
  },
  "excludePrivate": true,
  "excludeProtected": false,
  "hideGenerator": true,
  "readme": "README.md",
  "tsconfig": "tsconfig.json"
}
